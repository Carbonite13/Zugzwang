## Set up profile
PROFILE=

## Path configurations
# If the provided paths are not provided, and create permission is given,
# the server will create those directories for you and will be made available
# to the runtime.
DATA_DIRECTORY=
LOG_DIRECTORY=
TEMPLATE_DIRECTORY=

# the default permission is to allow the program to create
# the said directories
CREATE_DIRECTORY=

## Database configurations
# Available values for engine are postgresql and sqlite3
# in case of sqlite3, the filename option should be set and that shall handle
# the rest of the server configuration from db side.
ENGINE=

# when using postgresql DB, the following configuration should be set
# otherwise the server will follow the graceful exit procedure
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# If the engine is set to sqlite (or spotgresql), then only the dbname is checked for
# and it is used as the sqlite3 and postgresql database name
DB_NAME=

# the db wil be created in case the db is absent, otherwise, an error
# will bre raised
CREATE_DB=

# Whether the db should be invoked with debug/echo mode enabled
# making it comfortable for development and debugging
# CAUTION: NEVER ENABLE DEBUG IN PRODUCTION
DEBUG=

